# Settings for running WITHOUT a database (for example on Vercel).
# Set them in Vercel → Project → Settings → Environment Variables, then redeploy.
# Never commit real values. With config/config.php and a database, none of these are used.

# Admin dashboard sign-in (required to switch the dashboard on)
ADMIN_EMAIL=you@example.com
# Either a bcrypt hash (preferred): php -r "echo password_hash('your password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
# ...or a plain password of at least 12 characters (only if ADMIN_PASSWORD_HASH is empty)
ADMIN_PASSWORD=

# Optional: key for signing admin sessions, 64 random hex characters
# php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Optional: shown on the Contact and Report pages
CONTACT_EMAIL=

# Optional: match IDs to block, separated by commas (find IDs in the admin's Moderation tool).
# For short links, use the code after /s/.
BLOCKED_MATCHES=

# Short share links (www.example.com/s/AbC123xYz9). Added automatically when you connect a
# Vercel Blob store: Vercel → Project → Storage → Create → Blob → Connect. Never set it by hand.
BLOB_READ_WRITE_TOKEN=
